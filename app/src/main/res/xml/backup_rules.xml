<?xml version="1.0" encoding="utf-8"?>
<!--
    Aura stores chats, memories, projects, settings, and related personal data locally.
    Exclude every app-data domain from legacy Android Auto Backup and device transfer.
    Manual encrypted export will be implemented separately with explicit user action.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
